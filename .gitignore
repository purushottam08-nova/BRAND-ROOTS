@'
# Environment variables and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
coverage/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Local database files
*.sqlite3
*.db
'@ | Set-Content -Path .gitignore -Encoding utf8